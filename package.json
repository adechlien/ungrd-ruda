{
  "name": "ruda-web",
  "version": "0.0.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 127.0.0.1 --port 4305 --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:contract && npm run test:frontend",
    "contract:build": "node server/scripts/build-contract.cjs",
    "api": "npm run contract:build && node server/index.mjs",
    "db:migrate": "node server/migrate.mjs",
    "db:seed": "npm run contract:build && node server/seed.mjs",
    "db:up": "docker compose up -d db",
    "test:api": "node server/scripts/test-program.mjs",
    "test:predeploy": "npm run contract:build && npm run build && npm run test:frontend && node server/scripts/test-program.mjs",
    "test:contract": "npm run contract:build && node --test server/tests/form-contract.test.mjs server/tests/statistics.test.mjs server/tests/v8-contract.test.mjs",
    "test:frontend": "node server/scripts/test-frontend.mjs"
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@tabler/icons-angular": "^3.46.0",
    "@tailwindcss/postcss": "^4.3.3",
    "colombia-territorial": "^1.1.0",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "postcss": "^8.5.26",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/compiler-cli": "^21.2.25",
    "esbuild": "^0.28.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
